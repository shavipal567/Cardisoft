{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "entrypoint": "backend/main.py",
      "routePrefix": "/api",
      "framework": "fastapi",
      "memory": 4096,
      "maxDuration": 300,
      "includeFiles": [
        "backend/**",
        "training/**",
        "dataset/dataset.csv"
      ],
      "excludeFiles": [
        "backend/tests/**",
        "training/tests/**",
        "training/experiments/**",
        "dataset/**/*.ipynb",
        "dataset/engineered_feature_analysis/**"
      ]
    }
  }
}
