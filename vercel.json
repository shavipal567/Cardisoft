{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/"
    },
    "backend": {
      "root": ".",
      "entrypoint": "backend.main:app",
      "framework": "fastapi",
      "functions": {
        "backend/main.py": {
          "maxDuration": 300,
          "includeFiles": "{training/artifacts/**,dataset/dataset.csv}",
          "excludeFiles": "frontend/heart-parts-source/**"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
