+   "source": [
+    "# choose how many top PCs (by Fisher Distance) and how many loadings per PC to display\n",
+    "top_pcs_to_explain = 5\n",
+    "top_loadings = 8\n",
+    "\n",
+    "# pc_fisher_df already computed; pick the most discriminative PCs\n",
+    "top_pc_list = (\n",
+    "    pc_fisher_df.sort_values(\"fisher_distance\", ascending=False)\n",
+    "                .head(top_pcs_to_explain)[\"pc\"]\n",
+    "                .tolist()\n",
+    ")\n",
+    "\n",
+    "# Build a loadings DataFrame: rows=PCs, cols=original features\n",
+    "# sklearn PCA components_: shape (n_components, n_features)\n",
+    "loadings = pd.DataFrame(\n",
+    "    pca.components_.T,\n",
+    "    index=features,\n",
+    "    columns=[f\"PC{i+1}\" for i in range(pca.components_.shape[0])]\n",
+    ")\n",
+    "\n",
+    "def show_top_loadings_for_pc(pc_name, top_n=8):\n",
+    "    s = loadings[pc_name].copy()\n",
+    "    out = (s.abs()\n",
+    "             .sort_values(ascending=False)\n",
+    "             .head(top_n)\n",
+    "             .to_frame(name=\"loading\"))\n",
+    "    out[\"signed_loading\"] = s.loc[out.index].values\n",
+    "    return out\n",
+    "\n",
+    "for pc in top_pc_list:\n",
+    "    print(f\"\\n=== Top {top_loadings} loadings for {pc} (highest |loading|) ===\")\n",
+    "    display(show_top_loadings_for_pc(pc, top_n=top_loadings))\n",
+    "\n",
+    "\n",
+    "# quick table for ONE PC (e.g., PC1)\n",
+    "pc_to_export = top_pc_list[0]  # usually PC1\n",
+    "tbl = show_top_loadings_for_pc(pc_to_export, top_n=top_loadings).reset_index().rename(columns={\"index\":\"feature\"})\n",
