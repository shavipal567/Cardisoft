+    "# Inputs\n",
+    "data = df_zclean.copy()\n",
+    "label_col = \"Cath\"\n",
+    "feature = \"Age\"   # choose feature here\n",
+    "\n",
+    "# If your labels differ, adjust map:\n",
+    "label_map = {\"Normal\": 0, \"Cad\": 1}\n",
+    "\n",
+    "# Encode label\n",
+    "y = data[label_col].map(label_map) if data[label_col].dtype == \"object\" else data[label_col].astype(int)\n",
+    "if y.isna().any():\n",
+    "    raise ValueError(f\"Label encoding produced NaNs. Check unique values in {label_col}: {data[label_col].unique()}\")\n",
+    "\n",
+    "# Split feature by class\n",
+    "x0_all = data.loc[y == 0, feature].dropna().astype(float).values  # Normal\n",
+    "x1_all = data.loc[y == 1, feature].dropna().astype(float).values  # CAD\n",
+    "\n",
+    "print(\"Available samples:\", \"Normal =\", len(x0_all), \"| CAD =\", len(x1_all))\n",
+    "\n",
+    "\n",
+    "# Helpers\n",
+    "def cohens_d(x1, x0):\n",
+    "    # Cohen's d using pooled SD (common in reporting); Welch t-test still used for p-value.\n",
+    "    n1, n0 = len(x1), len(x0)\n",
+    "    s1, s0 = np.var(x1, ddof=1), np.var(x0, ddof=1)\n",
+    "    sp = np.sqrt(((n1 - 1) * s1 + (n0 - 1) * s0) / (n1 + n0 - 2))\n",
+    "    return (np.mean(x1) - np.mean(x0)) / sp\n",
+    "\n",
+    "def welch_ci_mean_diff(x1, x0, alpha=0.05):\n",
+    "    # CI for (mean1 - mean0) under Welch\n",
+    "    m1, m0 = np.mean(x1), np.mean(x0)\n",
+    "    v1, v0 = np.var(x1, ddof=1), np.var(x0, ddof=1)\n",
+    "    n1, n0 = len(x1), len(x0)\n",
+    "    se = np.sqrt(v1/n1 + v0/n0)\n",
+    "\n",
+    "    # Welch-Satterthwaite df\n",
+    "    df = (v1/n1 + v0/n0)**2 / ((v1/n1)**2/(n1-1) + (v0/n0)**2/(n0-1))\n",
+    "    tcrit = stats.t.ppf(1 - alpha/2, df)\n",
+    "    diff = m1 - m0\n",
+    "    return diff - tcrit*se, diff + tcrit*se, df\n",
+    "\n",
+    "def run_once(n, seed=0):\n",
+    "    rng = np.random.default_rng(seed)\n",
+    "    if len(x0_all) < n or len(x1_all) < n:\n",
+    "        raise ValueError(\"Not enough samples in one of the classes for the requested n.\")\n",
+    "\n",
+    "    x0 = rng.choice(x0_all, size=n, replace=False)\n",
+    "    x1 = rng.choice(x1_all, size=n, replace=False)\n",
+    "\n",
+    "    # Welch t-test (two-sided)\n",
+    "    tstat, pval = stats.ttest_ind(x1, x0, equal_var=False)\n",
+    "    ci_lo, ci_hi, df = welch_ci_mean_diff(x1, x0)\n",
+    "\n",
+    "    out = {\n",
+    "        \"n_per_class\": n,\n",
+    "        \"mean_Normal\": np.mean(x0),\n",
+    "        \"std_Normal\": np.std(x0, ddof=1),\n",
+    "        \"mean_CAD\": np.mean(x1),\n",
+    "        \"std_CAD\": np.std(x1, ddof=1),\n",
+    "        \"mean_diff_CAD_minus_Normal\": np.mean(x1) - np.mean(x0),\n",
+    "        \"t_stat\": tstat,\n",
+    "        \"df\": df,\n",
+    "        \"p_value\": pval,\n",
+    "        \"CI95_diff_low\": ci_lo,\n",
+    "        \"CI95_diff_high\": ci_hi,\n",
+    "        \"cohens_d\": cohens_d(x1, x0),\n",
+    "    }\n",
+    "    return out\n",
+    "\n",
+    "\n",
+    "# Run for n=36 and n=64\n",
+    "res_36 = run_once(36, seed=0)\n",
+    "res_64 = run_once(64, seed=0)\n",
+    "\n",
+    "results = pd.DataFrame([res_36, res_64])\n",
+    "display(results)"
