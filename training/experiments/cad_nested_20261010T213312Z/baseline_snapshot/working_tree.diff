+    "from scipy.stats import pointbiserialr\n",
+    "from sklearn.feature_selection import mutual_info_classif\n",
+    "\n",
+    "# -------------------------\n",
+    "# 0) Choose which dataframe to use\n",
+    "# -------------------------\n",
+    "data = df_zclean.copy()   # use cleaned/capped data from Task 1\n",
+    "label_col = \"Cath\"        # adjust if your label column differs\n",
+    "\n",
+    "# 1) Select non-binary numerical features (same logic as before)\n",
+    "numerical_cols = data.select_dtypes(include=[\"number\"]).columns.tolist()\n",
+    "nonbinary_num_cols = [c for c in numerical_cols if data[c].nunique(dropna=True) > 2]\n",
+    "\n",
+    "# Extra: remove ordinal categorical-like numeric columns from correlation if desired\n",
+    "# Example: Function Class is ordinal/discrete; you may exclude it:\n",
+    "exclude_like_categorical = [\"Function Class\"]\n",
+    "nonbinary_num_cols = [c for c in nonbinary_num_cols if c not in exclude_like_categorical]\n",
+    "\n",
+    "print(\"Using # numeric features:\", len(nonbinary_num_cols))\n",
+    "print(nonbinary_num_cols)\n",
+    "\n",
+    "# 2) Feature–feature correlation matrices\n",
+    "pearson_corr = data[nonbinary_num_cols].corr(method=\"pearson\")\n",
+    "spearman_corr = data[nonbinary_num_cols].corr(method=\"spearman\")\n",
+    "\n",
+    "# Plot heatmaps\n",
+    "plt.figure(figsize=(12, 10))\n",
+    "sns.heatmap(pearson_corr, cmap=\"coolwarm\", center=0, square=True)\n",
+    "plt.title(\"Pearson Correlation Heatmap (numeric features)\")\n",
+    "plt.tight_layout()\n",
+    "plt.show()\n",
+    "\n",
+    "plt.figure(figsize=(12, 10))\n",
+    "sns.heatmap(spearman_corr, cmap=\"coolwarm\", center=0, square=True)\n",
+    "plt.title(\"Spearman Correlation Heatmap (numeric features)\")\n",
+    "plt.tight_layout()\n",
+    "plt.show()\n",
+    "\n",
+    "# 3) Find strongest correlated feature pairs (avoid duplicates)\n",
+    "def top_corr_pairs(corr_mat, top_n=15):\n",
+    "    c = corr_mat.copy()\n",
+    "    np.fill_diagonal(c.values, np.nan)\n",
+    "    pairs = (\n",
+    "        c.stack()\n",
+    "         .reset_index()\n",
+    "         .rename(columns={\"level_0\":\"feature_1\", \"level_1\":\"feature_2\", 0:\"corr\"})\n",
+    "    )\n",
+    "    # remove duplicate pairs (A,B) vs (B,A) by sorting names\n",
+    "    pairs[\"pair_key\"] = pairs.apply(lambda r: \"||\".join(sorted([r[\"feature_1\"], r[\"feature_2\"]])), axis=1)\n",
+    "    pairs = pairs.drop_duplicates(\"pair_key\").drop(columns=\"pair_key\")\n",
+    "    pairs[\"abs_corr\"] = pairs[\"corr\"].abs()\n",
+    "    return pairs.sort_values(\"abs_corr\", ascending=False).head(top_n)\n",
+    "\n",
+    "print(\"\\nTop Pearson correlated pairs:\")\n",
+    "display(top_corr_pairs(pearson_corr, top_n=15))\n",
+    "\n",
+    "print(\"\\nTop Spearman correlated pairs:\")\n",
+    "display(top_corr_pairs(spearman_corr, top_n=15))\n"
+   ]
