    <td>Lymph</td>\n      <td>0.200024</td>\n      <td>-0.080565</td>\n      <td>0.906178</td>\n      <td>1.015184</td>\n      <td>0.040976</td>\n    </tr>\n    <tr>\n      <th>10</th>\n      <td>Neut</td>\n      <td>-0.195520</td>\n      <td>0.078751</td>\n      <td>0.921817</td>\n      <td>1.009891</td>\n      <td>0.038942</td>\n    </tr>\n    <tr>\n      <th>11</th>\n      <td>CR</td>\n      <td>-0.135550</td>\n      <td>0.054597</td>\n      <td>0.508122</td>\n      <td>1.187736</td>\n      <td>0.021320</td>\n    </tr>\n    <tr>\n      <th>12</th>\n      <td>Na</td>\n      <td>0.141250</td>\n      <td>-0.056892</td>\n      <td>0.792350</td>\n      <td>1.072364</td>\n      <td>0.021054</td>\n    </tr>\n    <tr>\n      <th>13</th>\n      <td>BUN</td>\n      <td>-0.134872</td>\n      <td>0.054323</td>\n      <td>0.887148</td>\n      <td>1.035176</td>\n      <td>0.018621</td>\n    </tr>\n    <tr>\n      <th>14</th>\n      <td>BMI</td>\n      <td>0.125294</td>\n      <td>-0.050466</td>\n      <td>1.170460</td>\n      <td>0.922472</td>\n      <td>0.014760</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x600 with 1 Axes>","image/png":""},"metadata":{}}],"execution_count":15},{"cell_type":"markdown","source":"---\n## Task 4. PCA Transformation + Fisher Distance for PC Scores\nApply PCA to the z-scored dataset, treat each PC projection as a feature, and compute Fisher Distance for each PC.\nCompare FD(PC) with FD(original features) and analyze whether explained variance (eigenvalues) relates to class separability.","metadata":{}},{"cell_type":"code","source":"from sklearn.decomposition import PCA\n\n# 0) Inputs\ndata = df_zclean.copy()\nlabel_col = \"Cath\"\n\n# label encoding (adjust if needed)\nlabel_map = {\"Normal\": 0, \"Cad\": 1}\ny = data[label_col].map(label_map) if data[label_col].dtype == \"object\" else data[label_col].astype(int)\nif y.isna().any():\n    raise ValueError(f\"Label encoding produced NaNs. Check unique values in {label_col}: {data[label_col].unique()}\")\n\n# numeric feature selection (same as Task 3)\nnumerical_cols = data.select_dtypes(include=[\"number\"]).columns.tolist()\nnonbinary_num_cols = [c for c in numerical_cols if data[c].nunique(dropna=True) > 2]\nexclude_like_categorical = [\"Function Class\"]\nfeatures = [c for c in nonbinary_num_cols if c not in exclude_like_categorical]\n\nX = data[features].astype(float)\n\n# 1) Z-score normalize BEFORE PCA (recommended)\nmu = X.mean(axis=0)\nsigma = X.std(axis=0, ddof=0).replace(0, np.nan)\nXz = (X - mu) / sigma\nXz = Xz.fillna(0.0)  # in case any column had 0 std (rare after filtering)\n\n# 2) PCA fit\npca = PCA()\nZ = pca.fit_transform(Xz.values)  # PC scores (projections)\nexplained_var = pca.explained_variance_              # eigenvalues of covariance matrix in sklearn's convention\nexplained_ratio = pca.explained_variance_ratio_      # normalized eigenvalues\n\npc_names = [f\"PC{i+1}\" for i in range(Z.shape[1])]\nZdf = pd.DataFrame(Z, columns=pc_names, index=data.index)\n\n# 3) Fisher Distance per PC\nmask0 = (y == 0)\nmask1 = (y == 1)\neps = 1e-12\n\npc_rows = []\nfor pc in pc_names:\n    z0 = Zdf.loc[mask0, pc]\n    z1 = Zdf.loc[mask1, pc]\n\n    m0, m1 = z0.mean(), z1.mean()\n    v0, v1 = z0.var(ddof=0), z1.var(ddof=0)\n    fd = (m1 - m0)**2 / (v0 + v1 + eps)\n\n    pc_rows.append({\n        \"pc\": pc,\n        \"pc_index\": int(pc.replace(\"PC\",\"\")),\n        \"eigenvalue\": explained_var[int(pc.replace(\"PC\",\"\")) - 1],\n        \"explained_variance_ratio\": explained_ratio[int(pc.replace(\"PC\",\"\")) - 1],\n        \"fisher_distance\": fd\n    })\n\npc_fisher_df = pd.DataFrame(pc_rows).sort_values(\"pc_index\").reset_index(drop=True)\n\nprint(\"Top 10 PCs by Fisher Distance:\")\ndisplay(pc_fisher_df.sort_values(\"fisher_distance\", ascending=False).head(10))\n\n# 4) Plots\n# (a) Scree plot: explained variance ratio\nplt.figure(figsize=(10, 4))\nplt.plot(range(1, len(explained_ratio)+1), explained_ratio, marker=\"o\")\nplt.title(\"PCA Scree Plot (Explained Variance Ratio per PC)\")\nplt.xlabel(\"Principal Component\")\nplt.ylabel(\"Explained Variance Ratio\")\nplt.tight_layout()\nplt.show()\n\n# (b) Fisher Distance per PC (line plot)\nplt.figure(figsize=(10, 4))\nplt.plot(pc_fisher_df[\"pc_index\"], pc_fisher_df[\"fisher_distance\"], marker=\"o\", color=\"tab:green\")\nplt.title(\"Fisher Distance for PCA-Projected Features (PC Scores)\")\nplt.xlabel(\"Principal Component\")\nplt.ylabel(\"Fisher Distance\")\nplt.tight_layout()\nplt.show()\n\n# (c) Relationship: eigenvalue/explained variance vs Fisher Distance\nplt.figure(figsize=(6, 5))\nsns.scatterplot(data=pc_fisher_df, x=\"explained_variance_ratio\", y=\"fisher_distance\")\nplt.title(\"Explained Variance Ratio vs Fisher Distance (per PC)\")\nplt.xlabel(\"Explained Variance Ratio (Eigenvalue / Total)\")\nplt.ylabel(\"Fisher Distance\")\nplt.tight_layout()\nplt.show()\n\n# Extra: compute correlation between explained variance and FD\ncorr_ev_fd = pc_fisher_df[\"explained_variance_ratio\"].corr(pc_fisher_df[\"fisher_distance\"], method=\"spearman\")\nprint(f\"Spearman correlation between explained variance ratio and Fisher Distance: {corr_ev_fd:.3f}\")\n\n# 5) Compare Task 3 vs Task 4 (simple comparison)\n# Assumes fisher_df exists from Task 3 with column 'fisher_distance'\nbest_original_fd = fisher_df[\"fisher_distance\"].max() if \"fisher_df\" in globals() else None\nbest_pc_fd = pc_fisher_df[\"fisher_distance\"].max()\n\nprint(\"Best Fisher Distance among original features (Task 3):\", best_original_fd)\nprint(\"Best Fisher Distance among PCs (Task 4):\", best_pc_fd)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-26T13:54:28.542216Z","iopub.execute_input":"2026-05-26T13:54:28.542538Z","iopub.status.idle":"2026-05-26T13:54:29.632505Z","shell.execute_reply.started":"2026-05-26T13:54:28.542512Z","shell.execute_reply":"2026-05-26T13:54:29.631211Z"}},"outputs":[{"name":"stdout","text":"Top 10 PCs by Fisher Distance:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"      pc  pc_index  eigenvalue  explained_variance_ratio  fisher_distance\n0    PC1         1    2.935875                  0.133008         0.336781\n4    PC5         5    1.526613                  0.069162         0.170188\n2    PC3         3    1.898507                  0.086011         0.113269\n11  PC12        12    0.821748                  0.037229         0.064115\n16  PC17        17    0.512151                  0.023203         0.055489\n14  PC15        15    0.603586                  0.027345         0.034212\n19  PC20        20    0.373140                  0.016905         0.019711\n3    PC4         4    1.663781                  0.075377         0.017503\n1    PC2         2    2.204080                  0.099855         0.013706\n8    PC9         9    0.977976                  0.044307         0.012218","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>pc</th>\n      <th>pc_index</th>\n      <th>eigenvalue</th>\n      <th>explained_variance_ratio</th>\n      <th>fisher_distance</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>PC1</td>\n      <td>1</td>\n      <td>2.935875</td>\n      <td>0.133008</td>\n      <td>0.336781</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>PC5</td>\n      <td>5</td>\n      <td>1.526613</td>\n      <td>0.069162</td>\n      <td>0.170188</td>\n    </tr>\n    <tr>\n      <th>2</th>\n      <td>PC3</td>\n      <td>3</td>\n      <td>1.898507</td>\n      <td>0.086011</td>\n      <td>0.113269</td>\n    </tr>\n    <tr>\n      <th>11</th>\n      <td>PC12</td>\n      <td>12</td>\n      <td>0.821748</td>\n      <td>0.037229</td>\n      <td>0.064115</td>\n    </tr>\n    <tr>\n      <th>16</th>\n      <td>PC17</td>\n      <td>17</td>\n      <td>0.512151</td>\n      <td>0.023203</td>\n      <td>0.055489</td>\n    </tr>\n    <tr>\n      <th>14</th>\n      <td>PC15</td>\n      <td>15</td>\n      <td>0.603586</td>\n      <td>0.027345</td>\n      <td>0.034212</td>\n    </tr>\n    <tr>\n      <th>19</th>\n      <td>PC20</td>\n      <td>20</td>\n      <td>0.373140</td>\n      <td>0.016905</td>\n      <td>0.019711</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>PC4</td>\n      <td>4</td>\n      <td>1.663781</td>\n      <td>0.075377</td>\n      <td>0.017503</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>PC2</td>\n      <td>2</td>\n      <td>2.204080</td>\n      <td>0.099855</td>\n      <td>0.013706</td>\n    </tr>\n    <tr>\n      <th>8</th>\n      <td>PC9</td>\n      <td>9</td>\n      <td>0.977976</td>\n      <td>0.044307</td>\n      <td>0.012218</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x400 with 1 Axes>","image/png":""},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x400 with 1 Axes>","image/png":""},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 600x500 with 1 Axes>","image/png":""},"metadata":{}},{"name":"stdout","text":"Spearman correlation between explained variance ratio and Fisher Distance: 0.462\nBest Fisher Distance among original features (Task 3): 0.3756595833564719\nBest Fisher Distance among PCs (Task 4): 0.3367813332106236\n","output_type":"stream"}],"execution_count":16},{"cell_type":"markdown","source":"## Task 4 (Extra). PCA Loadings: What Drives the Most Discriminative PCs?\nExtract and display the top absolute loadings for the PCs with highest Fisher Distance (e.g., PC1, PC5) to interpret which original clinical variables contribute most.","metadata":{}},{"cell_type":"code","source":"# choose how many top PCs (by Fisher Distance) and how many loadings per PC to display\ntop_pcs_to_explain = 5\ntop_loadings = 8\n\n# pc_fisher_df already computed; pick the most discriminative PCs\ntop_pc_list = (\n    pc_fisher_df.sort_values(\"fisher_distance\", ascending=False)\n                .head(top_pcs_to_explain)[\"pc\"]\n                .tolist()\n)\n\n# Build a loadings DataFrame: rows=PCs, cols=original features\n# sklearn PCA components_: shape (n_components, n_features)\nloadings = pd.DataFrame(\n    pca.components_.T,\n    index=features,\n    columns=[f\"PC{i+1}\" for i in range(pca.components_.shape[0])]\n)\n\ndef show_top_loadings_for_pc(pc_name, top_n=8):\n    s = loadings[pc_name].copy()\n    out = (s.abs()\n             .sort_values(ascending=False)\n             .head(top_n)\n             .to_frame(name=\"loading\"))\n    out[\"signed_loading\"] = s.loc[out.index].values\n    return out\n\nfor pc in top_pc_list:\n    print(f\"\\n=== Top {top_loadings} loadings for {pc} (highest |loading|) ===\")\n    display(show_top_loadings_for_pc(pc, top_n=top_loadings))\n\n\n# quick table for ONE PC (e.g., PC1)\npc_to_export = top_pc_list[0]  # usually PC1\ntbl = show_top_loadings_for_pc(pc_to_export, top_n=top_loadings).reset_index().rename(columns={\"index\":\"feature\"})\n\nprint(\"\\n% --- Table for\", pc_to_export, \"---\")\nprint(\"\\\\begin{table}[h!]\")\nprint(\"\\\\centering\")\nprint(f\"\\\\caption{{Top {top_loadings} absolute PCA loadings for {pc_to_export}.}}\")\nprint(f\"\\\\label{{tab:pca_loadings_{pc_to_export.lower()}}}\")\nprint(\"\\\\begin{tabular}{lr}\")\nprint(\"\\\\hline\")\nprint(\"\\\\textbf{Feature} & \\\\textbf{Loading}\\\\\\\\\")\nprint(\"\\\\hline\")\nfor _, r in tbl.iterrows():\n    print(f\"{r['feature']} & {r['signed_loading']:.4f}\\\\\\\\\")\nprint(\"\\\\hline\")\nprint(\"\\\\end{tabular}\")\nprint(\"\\\\end{table}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-26T13:54:29.634404Z","iopub.execute_input":"2026-05-26T13:54:29.63498Z","iopub.status.idle":"2026-05-26T13:54:29.697133Z","shell.execute_reply.started":"2026-05-26T13:54:29.634937Z","shell.execute_reply":"2026-05-26T13:54:29.695902Z"}},"outputs":[{"name":"stdout","text":"\n=== Top 8 loadings for PC1 (highest |loading|) ===\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"              loading  signed_loading\nNeut         0.416703        0.416703\nLymph        0.411990       -0.411990\nEF-TTE       0.298634       -0.298634\nAge          0.277944        0.277944\nWBC          0.273966        0.273966\nESR          0.227477        0.227477\nRegion RWMA  0.210842        0.210842\nBUN          0.202471        0.202471","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>loading</th>\n      <th>signed_loading</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>Neut</th>\n      <td>0.416703</td>\n      <td>0.416703</td>\n    </tr>\n    <tr>\n      <th>Lymph</th>\n      <td>0.411990</td>\n      <td>-0.411990</td>\n    </tr>\n    <tr>\n      <th>EF-TTE</th>\n      <td>0.298634</td>\n      <td>-0.298634</td>\n    </tr>\n    <tr>\n      <th>Age</th>\n      <td>0.277944</td>\n      <td>0.277944</td>\n    </tr>\n    <tr>\n      <th>WBC</th>\n      <td>0.273966</td>\n      <td>0.273966</td>\n    </tr>\n    <tr>\n      <th>ESR</th>\n      <td>0.227477</td>\n      <td>0.227477</td>\n    </tr>\n    <tr>\n      <th>Region RWMA</th>\n      <td>0.210842</td>\n      <td>0.210842</td>\n    </tr>\n    <tr>\n      <th>BUN</th>\n      <td>0.202471</td>\n      <td>0.202471</td>\n    </tr>\n  </