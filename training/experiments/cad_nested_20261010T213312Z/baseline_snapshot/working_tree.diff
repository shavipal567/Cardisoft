  y = data[label_col].map(label_map)\nelse:\n    # if already 0/1 numeric\n    y = data[label_col].astype(int)\n\nif y.isna().any():\n    raise ValueError(\"Label encoding produced NaNs. Check unique values in Cath and adjust label_map.\")\n\n# 1.2 Point-biserial correlation (equivalent to Pearson between numeric x and binary y)\nlabel_corr_rows = []\nfor col in nonbinary_num_cols:\n    x = data[col].astype(float)\n    r, p = pointbiserialr(y, x)\n    label_corr_rows.append({\"feature\": col, \"point_biserial_r\": r, \"p_value\": p})\n\nlabel_corr_df = pd.DataFrame(label_corr_rows)\nlabel_corr_df[\"abs_r\"] = label_corr_df[\"point_biserial_r\"].abs()\nlabel_corr_df = label_corr_df.sort_values(\"abs_r\", ascending=False)\n\nprint(\"\\nTop features by |point-biserial r| with label:\")\ndisplay(label_corr_df.head(15))\n\n# 1.3 Spearman correlation with label (robust / rank-based)\nspearman_label = data[nonbinary_num_cols].apply(lambda s: s.corr(y, method=\"spearman\"))\nspearman_label_df = spearman_label.to_frame(\"spearman_r\").assign(abs_r=lambda d: d[\"spearman_r\"].abs())\nspearman_label_df = spearman_label_df.sort_values(\"abs_r\", ascending=False)\nprint(\"\\nTop features by |Spearman r| with label:\")\ndisplay(spearman_label_df.head(15))\n\n# 1.4 Mutual Information with label (captures non-linear association)\nX = data[nonbinary_num_cols].astype(float).values\nmi = mutual_info_classif(X, y.values, random_state=0, discrete_features=False)\nmi_df = pd.DataFrame({\"feature\": nonbinary_num_cols, \"mutual_information\": mi})\nmi_df = mi_df.sort_values(\"mutual_information\", ascending=False)\n\nprint(\"\\nTop features by Mutual Information with label:\")\ndisplay(mi_df.head(12))\n\n# 2) plot bar charts for top-k label associations\ntop_k = 15\n\nplt.figure(figsize=(10, 6))\nsns.barplot(data=label_corr_df.head(top_k), x=\"point_biserial_r\", y=\"feature\", orient=\"h\")\nplt.title(f\"Top {top_k} features by point-biserial correlation with label\")\nplt.tight_layout()\nplt.show()\n\nplt.figure(figsize=(10, 6))\nsns.barplot(data=mi_df.head(12), x=\"mutual_information\", y=\"feature\", orient=\"h\")\nplt.title(f\"Top 12 features by Mutual Information with label\")\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-26T13:54:27.005414Z","iopub.execute_input":"2026-05-26T13:54:27.005963Z","iopub.status.idle":"2026-05-26T13:54:28.054096Z","shell.execute_reply.started":"2026-05-26T13:54:27.005931Z","shell.execute_reply":"2026-05-26T13:54:28.052829Z"}},"outputs":[{"name":"stdout","text":"\nTop features by |point-biserial r| with label:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"        feature  point_biserial_r       p_value     abs_r\n0           Age          0.357247  1.499035e-10  0.357247\n21  Region RWMA          0.316011  1.879212e-08  0.316011\n20       EF-TTE         -0.248425  1.213172e-05  0.248425\n4            BP          0.237997  2.839447e-05  0.237997\n6           FBS          0.230151  5.252969e-05  0.230151\n12          ESR          0.194272  6.735170e-04  0.194272\n14            K          0.182200  1.446925e-03  0.182200\n5            PR          0.168176  3.321939e-03  0.168176\n8            TG          0.166963  3.559429e-03  0.166963\n17        Lymph         -0.126945  2.713786e-02  0.126945\n18         Neut          0.124086  3.082034e-02  0.124086\n15           Na         -0.089644  1.194454e-01  0.089644\n7            CR          0.086027  1.351652e-01  0.086027\n11          BUN          0.085596  1.371381e-01  0.085596\n3           BMI         -0.079518  1.673942e-01  0.079518","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n