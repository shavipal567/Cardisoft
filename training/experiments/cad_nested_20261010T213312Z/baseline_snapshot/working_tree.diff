style=\"text-align: right;\">\n      <th></th>\n      <th>loading</th>\n      <th>signed_loading</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>EF-TTE</th>\n      <td>0.478456</td>\n      <td>-0.478456</td>\n    </tr>\n    <tr>\n      <th>Age</th>\n      <td>0.440164</td>\n      <td>-0.440164</td>\n    </tr>\n    <tr>\n      <th>LDL</th>\n      <td>0.390290</td>\n      <td>0.390290</td>\n    </tr>\n    <tr>\n      <th>Region RWMA</th>\n      <td>0.329159</td>\n      <td>-0.329159</td>\n    </tr>\n    <tr>\n      <th>TG</th>\n      <td>0.264071</td>\n      <td>-0.264071</td>\n    </tr>\n    <tr>\n      <th>PR</th>\n      <td>0.255003</td>\n      <td>-0.255003</td>\n    </tr>\n    <tr>\n      <th>CR</th>\n      <td>0.188462</td>\n      <td>0.188462</td>\n    </tr>\n    <tr>\n      <th>K</th>\n      <td>0.184322</td>\n      <td>0.184322</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"name":"stdout","text":"\n% --- Table for PC1 ---\n\\begin{table}[h!]\n\\centering\n\\caption{Top 8 absolute PCA loadings for PC1.}\n\\label{tab:pca_loadings_pc1}\n\\begin{tabular}{lr}\n\\hline\n\\textbf{Feature} & \\textbf{Loading}\\\\\n\\hline\nNeut & 0.4167\\\\\nLymph & -0.4120\\\\\nEF-TTE & -0.2986\\\\\nAge & 0.2779\\\\\nWBC & 0.2740\\\\\nESR & 0.2275\\\\\nRegion RWMA & 0.2108\\\\\nBUN & 0.2025\\\\\n\\hline\n\\end{tabular}\n\\end{table}\n","output_type":"stream"}],"execution_count":17},{"cell_type":"markdown","source":"---\n## Task 5. PCA Visualization: Most vs Least Important Components\nPlot the data projected onto the two most important PCs (PC1 vs PC2) and the two least important PCs (last two PCs) using class-colored scatter plots.\nInterpret overlap and separability.","metadata":{}},{"cell_type":"code","source":"# 0) Inputs\ndata = df_zclean.copy()\nlabel_col = \"Cath\"\nlabel_map = {\"Normal\": 0, \"Cad\": 1}  # adjust if needed\n\n# 1) Encode label\ny = data[label_col].map(label_map) if data[label_col].dtype == \"object\" else data[label_col].astype(int)\nif y.isna().any():\n    raise ValueError(f\"Label encoding produced NaNs. Check unique values in {label_col}: {data[label_col].unique()}\")\n\n# 2) Select features + z-score normalize\nnumerical_cols = data.select_dtypes(include=[\"number\"]).columns.tolist()\nnonbinary_num_cols = [c for c in numerical_cols if data[c].nunique(dropna=True) > 2]\nexclude_like_categorical = [\"Function Class\"]\nfeatures = [c for c in nonbinary_num_cols if c not in exclude_like_categorical]\n\nX = data[features].astype(float)\nXz = (X - X.mean(axis=0)) / X.std(axis=0, ddof=0).replace(0, np.nan)\nXz = Xz.fillna(0.0)\n\n# 3) PCA\npca = PCA()\nZ = pca.fit_transform(Xz.values)\npc_names = [f\"PC{i+1}\" for i in range(Z.shape[1])]\nZdf = pd.DataFrame(Z, columns=pc_names)\nZdf[\"Cath\"] = y.map({0: \"Normal\", 1: \"Cad\"})\n\n# Most important PCs by eigenvalue: PC1 & PC2\ntop_pcs = (\"PC1\", \"PC2\")\n\n# Least important PCs by eigenvalue: last two PCs\nbottom_pcs = (pc_names[-2], pc_names[-1])  # e.g., PC21, PC22\n\nprint(\"Top PCs:\", top_pcs, \"Explained variance ratios:\",\n      pca.explained_variance_ratio_[0], pca.explained_variance_ratio_[1])\nprint(\"Bottom PCs:\", bottom_pcs, \"Explained variance ratios:\",\n      pca.explained_variance_ratio_[-2], pca.explained_variance_ratio_[-1])\n\n# 4) Plot: top 2 PCs\nplt.figure(figsize=(7, 6))\nsns.scatterplot(\n    data=Zdf, x=top_pcs[0], y=top_pcs[1],\n    hue=\"Cath\", style=\"Cath\",\n    alpha=0.85, s=60\n)\nplt.title(f\"Projection onto Two Most Important PCs: {top_pcs[0]} vs {top_pcs[1]}\")\nplt.axhline(0, color=\"gray\", linewidth=0.7)\nplt.axvline(0, color=\"gray\", linewidth=0.7)\nplt.tight_layout()\nplt.show()\n\n# 5) Plot: bottom 2 PCs\nplt.figure(figsize=(7, 6))\nsns.scatterplot(\n    data=Zdf, x=bottom_pcs[0], y=bottom_pcs[1],\n    hue=\"Cath\", style=\"Cath\",\n    alpha=0.85, s=60\n)\nplt.title(f\"Projection onto Two Least Important PCs: {bottom_pcs[0]} vs {bottom_pcs[1]}\")\nplt.axhline(0, color=\"gray\", linewidth=0.7)\nplt.axvline(0, color=\"gray\", linewidth=0.7)\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-26T13:54:29.698919Z","iopub.execute_input":"2026-05-26T13:54:29.699278Z","iopub.status.idle":"2026-05-26T13:54:30.555561Z","shell.execute_reply.started":"2026-05-26T13:54:29.699245Z","shell.execute_reply":"2026-05-26T13:54:30.554384Z"}},"outputs":[{"name":"stdout","text":"Top PCs: ('PC1', 'PC2') Explained variance ratios: 0.13300842557854486 0.09985481185726666\nBottom PCs: ('PC21', 'PC22') Explained variance ratios: 0.003113688955101365 0.00019112330355109075\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 700x600 with 1 Axes>","image/png":""},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 700x600 with 1 Axes>","image/png":""},"metadata":{}}],"execution_count":18},{"cell_type":"markdown","source":"---\n## Task 6. LDA Dimensionality Reduction (2D Display) and Comparison with PCA\nCompute the LDA discriminant direction (binary case → 1D maximum) and visualize it in a 2D scatter plot using small vertical jitter.\nCompare PCA(PC1,PC2) vs LDA(LD1) visually and with bonus metrics (Fisher Distance and 5-fold CV accuracy).","metadata":{}},{"cell_type":"code","source":"from sklearn.discriminant_analysis import LinearDiscriminantAnalysis as LDA\nfrom sklearn.model_selection import StratifiedKFold, cross_val_score\nfrom sklearn.pipeline import Pipeline\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.linear_model import LogisticRegression\n\n# 0) Inputs\ndata = df_zclean.copy()\nlabel_col = \"Cath\"\nlabel_map = {\"Normal\": 0, \"Cad\": 1}   # adjust if needed\n\n# 1) Encode labels\ny = data[label_col].map(label_map) if data[label_col].dtype == \"object\" else data[label_col].astype(int)\nif y.isna().any():\n    raise ValueError(f\"Label encoding produced NaNs. Check unique values in {label_col}: {data[label_col].unique()}\")\n\n# 2) Select features and z-score normalize (consistent with earlier tasks)\nnumerical_cols = data.select_dtypes(include=[\"number\"]).columns.tolist()\nnonbinary_num_cols = [c for c in numerical_cols if data[c].nunique(dropna=True) > 2]\nexclude_like_categorical = [\"Function Class\"]\nfeatures = [c for c in nonbinary_num_cols if c not in exclude_like_categorical]\n\nX = data[features].astype(float).values\n\nscaler = StandardScaler()\nXz = scaler.fit_transform(X)\n\n# 3) PCA to 2D (for comparison)\npca2 = PCA(n_components=2, random_state=0)\nXpca = pca2.fit_transform(Xz)\npca_df = pd.DataFrame(Xpca, columns=[\"PC1\", \"PC2\"])\npca_df[\"Cath\"] = y.map({0:\"Normal\", 1:\"Cad\"})\n\n# 4) LDA (binary => 1D max). We'll plot as 2D with y-jitter.\nlda = LDA(n_components=1)\nXlda1 = lda.fit_transform(Xz, y)  # shape (n,1)\n\nrng = np.random.default_rng(0)\ny_jitter = rng.normal(loc=0.0, scale=0.05, size=len(y))  # small jitter just for visualization\n\nlda_df = pd.DataFrame({\n    \"LD1\": Xlda1.flatten(),\n    \"LD2\": y_jitter,\n    \"Cath\": y.map({0:\"Normal\", 1:\"Cad\"})\n})\n\n# 5) Plot PCA(2D) vs LDA(visualized 2D)\nfig, axes = plt.subplots(1, 2, figsize=(14, 5))\n\nsns.scatterplot(data=pca_df, x=\"PC1\", y=\"PC2\", hue=\"Cath\", style=\"Cath\", alpha=0.85, s=55, ax=axes[0])\naxes[0].set_title(\"PCA 2D Projection (PC1 vs PC2)\")\naxes[0].axhline(0, color=\"gray\", linewidth=0.7)\naxes[0].axvline(0, color=\"gray\", linewidth=0.7)\n\nsns.scatterplot(data=lda_df, x=\"LD1\", y=\"LD2\", hue=\"Cath\", style=\"Cath\", alpha=0.85, s=55, ax=axes[1])\naxes[1].set_title(\"LDA Projection (LD1 shown in 2D with small y-jitter)\")\naxes[1].axhline(0, color=\"gray\", linewidth=0.7)\naxes[1].axvline(0, color=\"gray\", linewidth=0.7)\naxes[1].set_ylabel(\"\")  # LD2 is only jitter\n\nplt.tight_layout()\nplt.show()\n\n# 6) BONUS: Quantify separability\n# 6.1 Fisher distance in the embedded spaces\ndef fisher_distance_1d(x, y):\n    x0, x1 = x[y==0], x[y==1]\n    m0, m1 = x0.mean(), x1.mean()\n    v0, v1 = x0.var(ddof=0), x1.var(ddof=0)\n    return (m1 - m0)**2 / (v0 + v1 + 1e-12)\n\nfd_pc1 = fisher_distance_1d(Xpca[:,0], y.values)\nfd_lda1 = fisher_distance_1d(Xlda1.flatten(), y.values)\n\nprint(f\"Fisher Distance on PC1 (PCA 2D embedding, axis 1): {fd_pc1:.4f}\")\nprint(f\"Fisher Distance on LD1 (LDA embedding): {fd_lda1:.4f}\")\n\n# 6.2 Simple classification accuracy (5-fold CV) using only the 2D embedding\ncv = StratifiedKFold(n_splits=5, shuffle=True, random_state=0)\n\nclf = LogisticRegression(max_iter=2000)\n\nacc_pca2 = cross_val_score(clf, Xpca, y, cv=cv, scoring=\"accuracy\").mean()\nacc_lda1 = cross_val_score(clf, Xlda1, y, cv=cv, scoring=\"accuracy\").mean()\n\nprint(f\"5-fold CV accuracy using PCA 2D coordinates (PC1,PC2): {acc_pca2:.3f}\")\nprint(f\"5-fold CV accuracy using LDA 1D coordinate (LD1): {acc_lda1:.3f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-26T13:54:30.557354Z","iopub.execute_input":"2026-05-26T13:54:30.557899Z","iopub.status.idle":"2026-05-26T13:54:31.442141Z","shell.execute_reply.started":"2026-05-26T13:54:30.557867Z","shell.execute_reply":"2026-05-26T13:54:31.440987Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1400x500 with 2 Axes>","image/png":""},"metadata":{}},{"name":"stdout","text":"Fisher Distance on PC1 (PCA 2D embedding, axis 1): 0.3368\nFisher Distance on LD1 (LDA embedding): 1.3599\n5-fold CV accuracy using PCA 2D coordinates (PC1,PC2): 0.746\n5-fold CV accuracy using LDA 1D coordinate (LD1): 0.798\n","output_type":"stream"}],"execution_count":19},{"cell_type":"markdown","source":"## Task 7A. One cell: preprocessing + PCA(2D) + helper plotting","metadata":{}},{"cell_type":"code","source":"# Inputs\ndata = df_zclean.copy()\nlabel_col = \"Cath\"\nlabel_map = {\"Normal\": 0, \"Cad\": 1}  # adjust if needed\n\n# Encode label for metrics; keep class names for plotting\ny = data[label_col].map(label_map) if data[label_col].dtype == \"object\" else data[label_col].astype(int)\nclass_name = y.map({0:\"Normal\", 1:\"Cad\"})\n\n# Feature selection \nnumerical_cols = data.select_dtypes(include=[\"number\"]).columns.tolist()\nnonbinary_num_cols = [c for c in numerical_cols if data[c].nunique(dropna=True) > 2]\nexclude_like_categorical = [\"Function Class\"]\nfeatures = [c for c in nonbinary_num_cols if c not in exclude_like_categorical]\n\nX = data[features].astype(float).values\n\n# Z-score (original-space input for t-SNE and SOM)\nscaler = StandardScaler()\nXz = scaler.fit_transform(X)\n\n# PCA(2D) for K-Means and DBSCAN as required\npca2 = PCA(n_components=2, random_state=0)\nXpca2 = pca2.fit_transform(Xz)\n\nprint(\"Explained variance ratios (PC1, PC2):\", pca2.explained_variance_ratio_)\n\ndef scatter_by_class(ax, coords, title, xlabel, ylabel):\n    dfp = pd.DataFrame(coords, columns=[xlabel, ylabel])\n    dfp[\"Cath\"] = class_name.values\n    sns.scatterplot(data=dfp, x=xlabel, y=ylabel, hue=\"Cath\", style=\"Cath\",\n                    alpha=0.85, s=55, ax=ax)\n    ax.set_title(title)\n    ax.axhline(0, color=\"gray\", lw=0.7)\n    ax.axvline(0, color=\"gray\", lw=0.7)\n\ndef scatter_cluster_overlay(ax, coords, clusters, title, xlabel, ylabel):\n    dfp = pd.DataFrame(coords, columns=[xlabel, ylabel])\n    dfp[\"Cath\"] = class_name.values\n    dfp[\"cluster\"] = clusters\n\n    # Color = true class, marker = cluster id (keeps requirement: class colored)\n    sns.scatterplot(data=dfp, x=xlabel, y=ylabel, hue=\"Cath\",\n                    style=\"cluster\", palette=\"Set1\",\n                    alpha=0.85, s=55, ax=ax)\n    ax.set_title(title)\n    ax.axhline(0, color=\"gray\", lw=0.7)\n    ax.axvline(0, color=\"gray\", lw=0.7)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-26T13:54:31.443465Z","iopub.execute_input":"2026-05-26T13:54:31.443817Z","iopub.status.idle":"2026-05-26T13:54:31.4686Z","shell.execute_reply.started":"2026-05-26T13:54:31.443791Z","shell.execute_reply":"2026-05-26T13:54:31.467197Z"}},"outputs":[{"name":"stdout","text":"Explained variance ratios (PC1, PC2): [0.13300843 0.09985481]\n","output_type":"stream"}],"execution_count":20},{"cell_type":"markdown","source":"## Task 7B. K-Means Clustering on PCA(PC1, PC2)\nRun K-Means in the PCA 2D space (as required) and visualize clusters while coloring points by true class label.\nReport silhouette score and cluster–label agreement (ARI, NMI).","metadata":{}},{"cell_type":"code","source":"from sklearn.cluster import KMeans\nfrom sklearn.metrics import silhouette_score, adjusted_rand_score, normalized_mutual_info_score\n\nk = 2  # since you have 2 classes; you can also try k=3,4 as sensitivity\nkmeans = KMeans(n_clusters=k, n_init=50, random_state=0)\nkm_labels = kmeans.fit_predict(Xpca2)\n\nsil = silhouette_score(Xpca2, km_labels)\nari = adjusted_rand_score(y, km_labels)\nnmi = normalized_mutual_info_score(y, km_labels)\n\nprint(f\"K-Means on PCA(2D): k={k}\")\nprint(f\"Silhouette (clusters only): {sil:.3f}\")\nprint(f\"ARI vs true class: {ari:.3f}\")\nprint(f\"NMI vs true class: {nmi:.3f}\")\n\nfig, ax = plt.subplots(1, 1, figsize=(7, 6))\nscatter_cluster_overlay(ax, Xpca2, km_labels, f\"K-Means (k={k}) on PCA(PC1,PC2)\", \"PC1\", \"PC2\")\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-26T13:54:31.470077Z","iopub.execute_input":"2026-05-26T13:54:31.470395Z","iopub.status.idle":"2026-05-26T13:54:32.209913Z","shell.execute_reply.started":"2026-05-26T13:54:31.47037Z","shell.execute_reply":"2026-05-26T13:54:32.208445Z"}},"outputs":[{"name":"stdout","text":"K-Means on PCA(2D): k=2\nSilhouette (clusters only): 0.338\nARI vs true class: 0.007\nNMI vs true class: 0.055\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 700x600 with 1 Axes>","image/png":""},"metadata":{}}],"execution_count":21},{"cell_type":"markdown","source":"## Task 7C. DBSCAN Clustering on PCA(PC1, PC2)\nApply DBSCAN to PCA(2D) coordinates, visualize clusters/noise, and report number of clusters, number of noise points, and ARI/NMI vs the true label.","metadata":{}},{"cell_type":"code","source":"from sklearn.cluster import DBSCAN\nfrom sklearn.metrics import adjusted_rand_score, normalized_mutual_info_score\n\neps = 0.5\nmin_samples = 8\n\ndb = DBSCAN(eps=eps, min_samples=min_samples)\ndb_labels = db.fit_predict(Xpca2)\n\nn_noise = np.sum(db_labels == -1)\nn_clusters = len(set(db_labels)) - (1 if -1 in db_labels else 0)\n\nprint(f\"DBSCAN on PCA(2D): eps={eps}, min_samples={min_samples}\")\nprint(\"Clusters found:\", n_clusters, \"| Noise points:\", n_noise)\n\n# Only compute ARI/NMI if at least 2 clusters exist\nif n_clusters >= 2:\n    ari = adjusted_rand_score(y, db_labels)\n    nmi = normalized_mutual_info_score(y, db_labels)\n    print(f\"ARI vs true class: {ari:.3f}\")\n    print(f\"NMI vs true class: {nmi:.3f}\")\n\nfig, ax = plt.subplots(1, 1, figsize=(7, 6))\nscatter_cluster_overlay(ax, Xpca2, db_labels, \"DBSCAN on PCA(PC1,PC2)\", \"PC1\", \"PC2\")\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-26T13:54:32.214942Z","iopub.execute_input":"2026-05-26T13:54:32.215308Z","iopub.status.idle":"2026-05-26T13:54:32.693391Z","shell.execute_reply.started":"2026-05-26T13:54:32.215281Z","shell.execute_reply":"2026-05-26T13:54:32.69204Z"}},"outputs":[{"name":"stdout","text":"DBSCAN on PCA(2D): eps=0.5, min_samples=8\nClusters found: 2 | Noise points: 85\nARI vs true class: -0.016\nNMI vs true class: 0.014\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 700x600 with 1 Axes>","image/png":""},"metadata":{}}],"execution_count":22},{"cell_type":"markdown","source":"## Task 7D. t-SNE on Original Feature Space (Visualization + Clustering)\nCompute a 2D t-SNE embedding using original z-scored features.\nFor clustering summary, apply K-Means on the embedding and report silhouette + ARI/NMI.","metadata":{}},{"cell_type":"code","source":"from sklearn.manifold import TSNE\nfrom sklearn.cluster import KMeans\nfrom sklearn.metrics import silhouette_score, adjusted_rand_score, normalized_mutual_info_score\n\ntsne = TSNE(\n    n_components=2,\n    perplexity=30,\n    learning_rate=\"auto\",\n    init=\"pca\",\n    random_state=0\n)\nXtsne = tsne.fit_transform(Xz)\n\n# optional: cluster the t-SNE embedding using K-Means (k=2)\nk = 2\nkm_tsne = KMeans(n_clusters=k, n_init=50, random_state=0)\ntsne_clusters = km_tsne.fit_predict(Xtsne)\n\nsil = silhouette_score(Xtsne, tsne_clusters)\nari = adjusted_rand_score(y, tsne_clusters)\nnmi = normalized_mutual_info_score(y, tsne_clusters)\n\nprint(f\"t-SNE (original z-scored features) + K-Means(k={k})\")\nprint(f\"Silhouette: {sil:.3f}\")\nprint(f\"ARI vs true class: {ari:.3f}\")\nprint(f\"NMI vs true class: {nmi:.3f}\")\n\nfig, ax = plt.subplots(1, 1, figsize=(7, 6))\nscatter_cluster_overlay(ax, Xtsne, tsne_clusters, \"t-SNE embedding (2D) + K-Means clusters\", \"tSNE1\", \"tSNE2\")\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-26T13:54:32.695009Z","iopub.execute_input":"2026-05-26T13:54:32.695444Z","iopub.status.idle":"2026-05-26T13:54:34.979138Z","shell.execute_reply.started":"2026-05-26T13:54:32.695407Z","shell.execute_reply":"2026-05-26T13:54:34.977783Z"}},"outputs":[{"name":"stdout","text":"t-SNE (original z-scored features) + K-Means(k=2)\nSilhouette: 0.355\nARI vs true class: 0.049\nNMI vs true class: 0.056\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 700x600 with 1 Axes>","image/png":""},"metadata":{}}],"execution_count":23},{"cell_type":"markdown","source":"## Task 7E. SOM (Self-Organizing Map) on Original Feature Space\nTrain a Self-Organizing Map on the original z-scored features and visualize samples by their BMU (best matching unit) grid coordinates, colored by class.","metadata":{}},{"cell_type":"code","source":"!pip -q install minisom","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-26T13:54:34.980502Z","iopub.execute_input":"2026-05-26T13:54:34.980881Z","iopub.status.idle":"2026-05-26T13:54:51.091331Z","shell.execute_reply.started":"2026-05-26T13:54:34.980852Z","shell.execute_reply":"2026-05-26T13:54:51.08955Z"}},"outputs":[],"execution_count":24},{"cell_type":"code","source":"from minisom import MiniSom\n\n# SOM grid size (tunable). 10x10 works well for n=303\nsom_x, som_y = 10, 10\n\nsom = MiniSom(\n    x=som_x, y=som_y,\n    input_len=Xz.shape[1],\n    sigma=1.0, learning_rate=0.5,\n    neighborhood_function=\"gaussian\",\n    random_seed=0\n)\nsom.random_weights_init(Xz)\nsom.train_random(Xz, num_iteration=2000)  # adjust iterations if desired\n\n# Map each sample to BMU coordinate\nbmus = np.array([som.winner(x) for x in Xz])  # shape (n,2)\n\n# Add tiny jitter so points don't overlap perfectly\nrng = np.random.default_rng(0)\nbmus_jit = bmus + rng.normal(0, 0.08, size=bmus.shape)\n\nfig, ax = plt.subplots(1, 1, figsize=(7, 6))\ndfp = pd.DataFrame(bmus_jit, columns=[\"SOM_x\", \"SOM_y\"])\ndfp[\"Cath\"] = class_name.values\nsns.scatterplot(data=dfp, x=\"SOM_x\", y=\"SOM_y\", hue=\"Cath\", style=\"Cath\", alpha=0.85, s=55, ax=ax)\nax.set_title(\"SOM projection (BMU coordinates) on original z-scored features\")\nax.set_xlabel(\"SOM grid x (jittered)\")\nax.set_ylabel(\"SOM grid y (jittered)\")\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-26T13:54:51.093934Z","iopub.execute_input":"2026-05-26T13:54:51.094436Z","iopub.status.idle":"2026-05-26T13:54:51.660424Z","shell.execute_reply.started":"2026-05-26T13:54:51.094387Z","shell.execute_reply":"2026-05-26T13:54:51.659217Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 700x600 with 1 Axes>","image/png":""},"metadata":{}}],"execution_count":25},{"cell_type":"markdown","source":"---\n## Task 8. Hypothesis Testing: Two-Sample Welch t-test on a Selected Feature\nSelect one clinically meaningful feature (e.g., Age) and test whether class means differ:\nH0: μ_CAD = μ_Normal vs H1: μ_CAD ≠ μ_Normal.\nRun the test on random subsamples (n=36 and n=64 per class), report t-statistic, df, p-value, 95% CI, and Cohen’s d.","metadata":{}},{"cell_type":"code","source":"# Inputs\ndata = df_zclean.copy()\nlabel_col = \"Cath\"\nfeature = \"Age\"   # choose feature here\n\n# If your labels differ, adjust map:\nlabel_map = {\"Normal\": 0, \"Cad\": 1}\n\n# Encode label\ny = data[label_col].map(label_map) if data[label_col].dtype == \"object\" else data[label_col].astype(int)\nif y.isna().any():\n    raise ValueError(f\"Label encoding produced NaNs. Check unique values in {label_col}: {data[label_col].unique()}\")\n\n# Split feature by class\nx0_all = data.loc[y == 0, feature].dropna().astype(float).values  # Normal\nx1_all = data.loc[y == 1, feature].dropna().astype(float).values  # CAD\n\nprint(\"Available samples:\", \"Normal =\", len(x0_all), \"| CAD =\", len(x1_all))\n\n\n# Helpers\ndef cohens_d(x1, x0):\n    # Cohen's d using pooled SD (common in reporting); Welch t-test still used for p-value.\n    n1, n0 = len(x1), len(x0)\n    s1, s0 = np.var(x1, ddof=1), np.var(x0, ddof=1)\n    sp = np.sqrt(((n1 - 1) * s1 + (n0 - 1) * s0) / (n1 + n0 - 2))\n    return (np.mean(x1) - np.mean(x0)) / sp\n\ndef welch_ci_mean_diff(x1, x0, alpha=0.05):\n    # CI for (mean1 - mean0) under Welch\n    m1, m0 = np.mean(x1), np.mean(x0)\n    v1, v0 = np.var(x1, ddof=1), np.var(x0, ddof=1)\n    n1, n0 = len(x1), len(x0)\n    se = np.sqrt(v1/n1 + v0/n0)\n\n    # Welch-Satterthwaite df\n    df = (v1/n1 + v0/n0)**2 / ((v1/n1)**2/(n1-1) + (v0/n0)**2/(n0-1))\n    tcrit = stats.t.ppf(1 - alpha/2, df)\n    diff = m1 - m0\n    return diff - tcrit*se, diff + tcrit*se, df\n\ndef run_once(n, seed=0):\n    rng = np.random.default_rng(seed)\n    if len(x0_all) < n or len(x1_all) < n:\n        raise ValueError(\"Not enough samples in one of the classes for the requested n.\")\n\n    x0 = rng.choice(x0_all, size=n, replace=False)\n    x1 = rng.choice(x1_all, size=n, replace=False)\n\n    # Welch t-test (two-sided)\n    tstat, pval = stats.ttest_ind(x1, x0, equal_var=False)\n    ci_lo, ci_hi, df = welch_ci_mean_diff(x1, x0)\n\n    out = {\n        \"n_per_class\": n,\n        \"mean_Normal\": np.mean(x0),\n        \"std_Normal\": np.std(x0, ddof=1),\n        \"mean_CAD\": np.mean(x1),\n        \"std_CAD\": np.std(x1, ddof=1),\n        \"mean_diff_CAD_minus_Normal\": np.mean(x1) - np.mean(x0),\n        \"t_stat\": tstat,\n        \"df\": df,\n        \"p_value\": pval,\n        \"CI95_diff_low\": ci_lo,\n        \"CI95_diff_high\": ci_hi,\n        \"cohens_d\": cohens_d(x1, x0),\n    }\n    return out\n\n\n# Run for n=36 and n=64\nres_36 = run_once(36, seed=0)\nres_64 = run_once(64, seed=0)\n\nresults = pd.DataFrame([res_36, res_64])\ndisplay(results)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-26T13:54:51.662097Z","iopub.execute_input":"2026-05-26T13:54:51.662435Z","iopub.status.idle":"2026-05-26T13:54:51.706956Z","shell.execute_reply.started":"2026-05-26T13:54:51.662404Z","shell.execute_reply":"2026-05-26T13:54:51.705656Z"}},"outputs":[{"name":"stdout","text":"Available samples: Normal = 87 | CAD = 216\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"   n_per_class  mean_Normal  std_Normal   mean_CAD    std_CAD  mean_diff_CAD_minus_Normal    t_stat          df   p_value  CI95_diff_low  \\\n0           36    54.861111    9.574230  59.916667  10.781929                    5.055556  2.103664   69.034833  0.039053       0.261317   \n1           64    53.328125    9.841691  60.843750   9.462069                    7.515625  4.403969  125.805535  0.000022       4.138348   \n\n   CI95_diff_high  cohens_d  \n0        9.849795  0.495838  \n1       10.892902  0.778519  ","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>n_per_class</th>\n      <th>mean_Normal</th>\n      <th>std_Normal</th>\n      <th>mean_CAD</th>\n      <th>std_CAD</th>\n      <th>mean_diff_CAD_minus_Normal</th>\n      <th>t_stat</th>\n      <th>df</th>\n      <th>p_value</th>\n      <th>CI95_diff_low</th>\n      <th>CI95_diff_high</th>\n      <th>cohens_d</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>0</th>\n      <td>36</td>\n      <td>54.861111</td>\n      <td>9.574230</td>\n      <td>59.916667</td>\n      <td>10.781929</td>\n      <td>5.055556</td>\n      <td>2.103664</td>\n      <td>69.034833</td>\n      <td>0.039053</td>\n      <td>0.261317</td>\n      <td>9.849795</td>\n      <td>0.495838</td>\n    </tr>\n    <tr>\n      <th>1</th>\n      <td>64</td>\n      <td>53.328125</td>\n      <td>9.841691</td>\n      <td>60.843750</td>\n      <td>9.462069</td>\n      <td>7.515625</td>\n      <td>4.403969</td>\n      <td>125.805535</td>\n      <td>0.000022</td>\n      <td>4.138348</td>\n      <td>10.892902</td>\n      <td>0.778519</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":26}]}
