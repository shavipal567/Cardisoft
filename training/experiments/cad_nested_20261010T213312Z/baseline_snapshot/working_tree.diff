) // cols_per_row\n\nplt.figure(figsize=(5 * cols_per_row, 4 * num_rows))\nfor i, col in enumerate(nonbinary_numerical_cols):\n    plt.subplot(num_rows, cols_per_row, i + 1)\n    sns.boxplot(y=df[col], color='skyblue')\n    plt.title(col)\n    plt.tight_layout()\n\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-26T13:54:10.536518Z","iopub.execute_input":"2026-05-26T13:54:10.537057Z","iopub.status.idle":"2026-05-26T13:54:20.386314Z","shell.execute_reply.started":"2026-05-26T13:54:10.537019Z","shell.execute_reply":"2026-05-26T13:54:20.38502Z"}},"outputs":[{"name":"stdout","text":"Non-binary numerical columns: ['Age', 'Weight', 'Length', 'BMI', 'BP', 'PR', 'Function Class', 'FBS', 'CR', 'TG', 'LDL', 'HDL', 'BUN', 'ESR', 'HB', 'K', 'Na', 'WBC', 'Lymph', 'Neut', 'PLT', 'EF-TTE', 'Region RWMA']\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 2500x2000 with 23 Axes>","image/png":""},"metadata":{}}],"execution_count":9},{"cell_type":"markdown","source":"---\n## Task 1B. Outlier Detection and Data Cleaning (Modified z-score + Winsorization)\nDetect outliers per feature using the modified z-score (median + MAD) and cap extreme values (winsorization) instead of dropping rows to preserve the sample size.\nOutputs: outlier counts per feature, number of capped cells, and before/after boxplots.","metadata":{}},{"cell_type":"code","source":"import numpy as np\nimport pandas as pd\n\n# select non-binary numeric columns \nnumerical_cols = df.select_dtypes(include=[\"number\"]).columns.tolist()\nnonbinary_numerical_cols = [c for c in numerical_cols if df[c].nunique(dropna=True) > 2]\n\ndef robust_zscore(series):\n    \"\"\"\n    Robust z-score using median and MAD.\n    z = 0.6745 * (x - median) / MAD\n    \"\"\"\n    x = series.astype(float)\n    med = x.median()\n    mad = (x - med).abs().median()\n    if mad == 0 or np.isnan(mad):\n        # if no variability, return zeros (no outliers detectable)\n        return pd.Series(np.zeros(len(x)), index=series.index)\n    return 0.6745 * (x - med) / mad\n\nz_thresh = 3.5  # common robust threshold\ndf_zclean = df.copy()\noutlier_summary = []\n\nfor col in nonbinary_numerical_cols:\n    z = robust_zscore(df[col])\n    mask_out = z.abs() > z_thresh\n    n_out = int(mask_out.sum())\n\n    # winsorize by capping to boundary values at +/- threshold\n    # i.e., replace outliers with the most extreme non-outlier value on each side\n    lower_cap = df.loc[~mask_out, col].min()\n    upper_cap = df.loc[~mask_out, col].max()\n\n    df_zclean.loc[(z < -z_thresh), col] = lower_cap\n    df_zclean.loc[(z >  z_thresh), col] = upper_cap\n\n    outlier_summary.append({\n        \"feature\": col,\n        \"n_outliers\": n_out,\n        \"pct_outliers\": 100 * n_out / len(df)\n    })\n\noutlier_summary_df = pd.DataFrame(outlier_summary).sort_values(\"n_outliers\", ascending=False)\nprint(outlier_summary_df)\nprint(\"Original shape:\", df.shape, \"Cleaned shape:\", df_zclean.shape)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-26T13:54:20.387589Z","iopub.execute_input":"2026-05-26T13:54:20.387951Z","iopub.status.idle":"2026-05-26T13:54:20.477495Z","shell.execute_reply.started":"2026-05-26T13:54:20.387919Z","shell.execute_reply":"2026-05-26T13:54:20.476129Z"}},"outputs":[{"name":"stdout","text":"           feature  n_outliers  pct_outliers\n7              FBS          44     14.521452\n13             ESR          13      4.290429\n9               TG          12      3.960396\n5               PR          11      3.630363\n21          EF-TTE           9      2.970297\n12             BUN           8      2.640264\n16              Na           8      2.640264\n20             PLT           8      2.640264\n17             WBC           7      2.310231\n10             LDL           3      0.990099\n11             HDL           3      0.990099\n4               BP           2      0.660066\n1           Weight           1      0