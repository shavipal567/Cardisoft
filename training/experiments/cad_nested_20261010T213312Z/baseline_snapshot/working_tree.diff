+   "source": [
+    "from sklearn.decomposition import PCA\n",
+    "\n",
+    "# 0) Inputs\n",
+    "data = df_zclean.copy()\n",
+    "label_col = \"Cath\"\n",
+    "\n",
+    "# label encoding (adjust if needed)\n",
+    "label_map = {\"Normal\": 0, \"Cad\": 1}\n",
+    "y = data[label_col].map(label_map) if data[label_col].dtype == \"object\" else data[label_col].astype(int)\n",
+    "if y.isna().any():\n",
+    "    raise ValueError(f\"Label encoding produced NaNs. Check unique values in {label_col}: {data[label_col].unique()}\")\n",
+    "\n",
+    "# numeric feature selection (same as Task 3)\n",
+    "numerical_cols = data.select_dtypes(include=[\"number\"]).columns.tolist()\n",
+    "nonbinary_num_cols = [c for c in numerical_cols if data[c].nunique(dropna=True) > 2]\n",
+    "exclude_like_categorical = [\"Function Class\"]\n",
+    "features = [c for c in nonbinary_num_cols if c not in exclude_like_categorical]\n",
+    "\n",
+    "X = data[features].astype(float)\n",
+    "\n",
+    "# 1) Z-score normalize BEFORE PCA (recommended)\n",
+    "mu = X.mean(axis=0)\n",
+    "sigma = X.std(axis=0, ddof=0).replace(0, np.nan)\n",
+    "Xz = (X - mu) / sigma\n",
+    "Xz = Xz.fillna(0.0)  # in case any column had 0 std (rare after filtering)\n",
+    "\n",
+    "# 2) PCA fit\n",
+    "pca = PCA()\n",
+    "Z = pca.fit_transform(Xz.values)  # PC scores (projections)\n",
+    "explained_var = pca.explained_variance_              # eigenvalues of covariance matrix in sklearn's convention\n",
+    "explained_ratio = pca.explained_variance_ratio_      # normalized eigenvalues\n",
+    "\n",
+    "pc_names = [f\"PC{i+1}\" for i in range(Z.shape[1])]\n",
+    "Zdf = pd.DataFrame(Z, columns=pc_names, index=data.index)\n",
+    "\n",
+    "# 3) Fisher Distance per PC\n",
+    "mask0 = (y == 0)\n",
+    "mask1 = (y == 1)\n",
+    "eps = 1e-12\n",
+    "\n",
+    "pc_rows = []\n",
+    "for pc in pc_names:\n",
+    "    z0 = Zdf.loc[mask0, pc]\n",
+    "    z1 = Zdf.loc[mask1, pc]\n",
+    "\n",
+    "    m0, m1 = z0.mean(), z1.mean()\n",
+    "    v0, v1 = z0.var(ddof=0), z1.var(ddof=0)\n",
+    "    fd = (m1 - m0)**2 / (v0 + v1 + eps)\n",
+    "\n",
+    "    pc_rows.append({\n",
+    "        \"pc\": pc,\n",
+    "        \"pc_index\": int(pc.replace(\"PC\",\"\")),\n",
+    "        \"eigenvalue\": explained_var[int(pc.replace(\"PC\",\"\")) - 1],\n",
+    "        \"explained_variance_ratio\": explained_ratio[int(pc.replace(\"PC\",\"\")) - 1],\n",
+    "        \"fisher_distance\": fd\n",
+    "    })\n",
+    "\n",
+    "pc_fisher_df = pd.DataFrame(pc_rows).sort_values(\"pc_index\").reset_index(drop=True)\n",
+    "\n",
+    "print(\"Top 10 PCs by Fisher Distance:\")\n",
+    "display(pc_fisher_df.sort_values(\"fisher_distance\", ascending=False).head(10))\n",
+    "\n",
+    "# 4) Plots\n",
+    "# (a) Scree plot: explained variance ratio\n",
+    "plt.figure(figsize=(10, 4))\n",
+    "plt.plot(range(1, len(explained_ratio)+1), explained_ratio, marker=\"o\")\n",
+    "plt.title(\"PCA Scree Plot (Explained Variance Ratio per PC)\")\n",
+    "plt.xlabel(\"Principal Component\")\n",
+    "plt.ylabel(\"Explained Variance Ratio\")\n",
+    "plt.tight_layout()\n",
+    "plt.show()\n",
+    "\n",
+    "# (b) Fisher Distance per PC (line plot)\n",
+    "plt.figure(figsize=(10, 4))\n",
+    "plt.plot(pc_fisher_df[\"pc_index\"], pc_fisher_df[\"fisher_distance\"], marker=\"o\", color=\"tab:green\")\n",
+    "plt.title(\"Fisher Distance for PCA-Projected Features (PC Scores)\")\n",
+    "plt.xlabel(\"Principal Component\")\n",
+    "plt.ylabel(\"Fisher Distance\")\n",
+    "plt.tight_layout()\n",
+    "plt.show()\n",
+    "\n",
+    "# (c) Relationship: eigenvalue/explained variance vs Fisher Distance\n",
+    "plt.figure(figsize=(6, 5))\n",
+    "sns.scatterplot(data=pc_fisher_df, x=\"explained_variance_ratio\", y=\"fisher_distance\")\n",
+    "plt.title(\"Explained Variance Ratio vs Fisher Distance (per PC)\")\n",
+    "plt.xlabel(\"Explained Variance Ratio (Eigenvalue / Total)\")\n",
+    "plt.ylabel(\"Fisher Distance\")\n",
+    "plt.tight_layout()\n",
+    "plt.show()\n",
+    "\n",
+    "# Extra: compute correlation between explained variance and FD\n",
+    "corr_ev_fd = pc_fisher_df[\"explained_variance_ratio\"].corr(pc_fisher_df[\"fisher_distance\"], method=\"spearman\")\n",
+    "print(f\"Spearman correlation between explained variance ratio and Fisher Distance: {corr_ev_fd:.3f}\")\n",
+    "\n",
