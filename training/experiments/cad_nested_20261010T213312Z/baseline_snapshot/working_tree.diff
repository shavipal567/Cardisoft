h>\n      <td>Lymph</td>\n      <td>0.059058</td>\n    </tr>\n    <tr>\n      <th>6</th>\n      <td>FBS</td>\n      <td>0.057920</td>\n    </tr>\n    <tr>\n      <th>21</th>\n      <td>Region RWMA</td>\n      <td>0.057384</td>\n    </tr>\n    <tr>\n      <th>4</th>\n      <td>BP</td>\n      <td>0.047909</td>\n    </tr>\n    <tr>\n      <th>0</th>\n      <td>Age</td>\n      <td>0.032200</td>\n    </tr>\n    <tr>\n      <th>5</th>\n      <td>PR</td>\n      <td>0.018424</td>\n    </tr>\n    <tr>\n      <th>20</th>\n      <td>EF-TTE</td>\n      <td>0.016379</td>\n    </tr>\n    <tr>\n      <th>8</th>\n      <td>TG</td>\n      <td>0.015382</td>\n    </tr>\n    <tr>\n      <th>3</th>\n      <td>BMI</td>\n      <td>0.010941</td>\n    </tr>\n    <tr>\n      <th>10</th>\n      <td>HDL</td>\n      <td>0.000361</td>\n    </tr>\n    <tr>\n      <th>12</th>\n      <td>ESR</td>\n      <td>0.000351</td>\n    </tr>\n    <tr>\n      <th>16</th>\n      <td>WBC</td>\n      <td>0.000000</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x600 with 1 Axes>","image/png":""},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x600 with 1 Axes>","image/png":""},"metadata":{}}],"execution_count":14},{"cell_type":"markdown","source":"---\n## Task 3. Z-score Normalization + Fisher Distance per Feature\nStandardize numerical features using z-score and compute Fisher Distance for each feature to rank them by class separability (CAD vs Normal). \nIncludes a bar plot of the top features.","metadata":{}},{"cell_type":"code","source":"# 0) Inputs\ndata = df_zclean.copy()     # cleaned data from Task 1\nlabel_col = \"Cath\"          # adjust if needed\n\n\n# 1) Encode label as 0/1\nlabel_map = {\"Normal\": 0, \"Cad\": 1}   # adjust if your labels differ\nif data[label_col].dtype == \"object\":\n    y = data[label_col].map(label_map)\nelse:\n    y = data[label_col].astype(int)\n\nif y.isna().any():\n    raise ValueError(f\"Label encoding produced NaNs. Check unique values in {label_col}: {data[label_col].unique()}\")\n\n\n# 2) Select non-binary numeric features\nnumerical_cols = data.select_dtypes(include=[\"number\"]).columns.tolist()\nnonbinary_num_cols = [c for c in numerical_cols if data[c].nunique(dropna=True) > 2]\n\n# Optional: exclude discrete/ordinal-like columns if you don't want them treated as continuous\nexclude_like_categorical = [\"Function Class\"]\nfeatures = [c for c in nonbinary_num_cols if c not in exclude_like_categorical]\n\nprint(\"Number of features used:\", len(features))\n\n\n# 3) Z-score normalization (global, per feature)\nX = data[features].astype(float)\n\nmu = X.mean(axis=0)\nsigma = X.std(axis=0, ddof=0).replace(0, np.nan)  # avoid division by zero\nXz = (X - mu) / sigma\n\n\n# 4) Fisher Distance per feature (between classes)\nmask0 = (y == 0)\nmask1 = (y == 1)\n\nfisher_rows = []\neps = 1e-12  # numerical stability\n\nfor col in features:\n    x0 = Xz.loc[mask0, col].dropna()\n    x1 = Xz.loc[mask1, col].dropna()\n\n    m0, m1 = x0.mean(), x1.mean()\n    v0, v1 = x0.var(ddof=0), x1.var(ddof=0)\n\n    fd = (m1 - m0)**2 / (v0 + v1 + eps)\n\n    fisher_rows.append({\n        \"feature\": col,\n        \"mean_class0\": m0,\n        \"mean_class1\": m1,\n        \"var_class0\": v0,\n        \"var_class1\": v1,\n        \"fisher_distance\": fd\n    })\n\nfisher_df = pd.DataFrame(fisher_rows).sort_values(\"fisher_distance\", ascending=False).reset_index(drop=True)\n\nprint(\"\\nTop 15 features by Fisher Distance:\")\ndisplay(fisher_df.head(15))\n\n\n# 5) Plot: top-k Fisher Distances\ntop_k = 15\nplt.figure(figsize=(10, 6))\nsns.barplot(data=fisher_df.head(top_k), x=\"fisher_distance\", y=\"feature\", orient=\"h\")\nplt.title(f\"Top {top_k} features by Fisher Distance (z-score normalized)\")\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-26T13:54:28.055392Z","iopub.execute_input":"2026-05-26T13:54:28.055832Z","iopub.status.idle":"2026-05-26T13:54:28.540924Z","shell.execute_reply.started":"2026-05-26T13:54:28.055795Z","shell.execute_reply":"2026-05-26T13:54:28.539695Z"}},"outputs":[{"name":"stdout","text":"Number of features used: 22\n\nTop 15 features by Fisher Distance:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"        feature  mean_class0  mean_class1  var_class0  var_class1  fisher_distance\n0   Region RWMA    -0.497931     0.200555    0.060355    1.238383         0.375660\n1           Age    -0.562906     0.226726    0.797732    0.902439         0.366739\n2        EF-TTE     0.391437    -0.157662    0.763974    1.008494         0.170107\n3           FBS    -0.362644     0.146065    0.608137    1.083529         0.152976\n4            BP    -0.375007     0.151044    0.945216    0.942609         0.146587\n5           ESR    -0.306109     0.123294    0.763533    1.042301         0.102106\n6             K    -0.287088     0.115633    0.739017    1.058550         0.090224\n7            TG    -0.263079     0.105963    0.847633    1.022266         0.072834\n8            PR    -0.264991     0.106732    0.948761    0.980963         0.071605\n9         Lymph     0.200024    -0.080565    0.906178    1.015184         0.040976\n10         Neut    -0.195520     0.078751    0.921817    1.009891         0.038942\n11           CR    -0.135550     0.054597    0.508122    1.187736         0.021320\n12           Na     0.141250    -0.056892    0.792350    1.072364         0.021054\n13          BUN    -0.134872     0.054323    0.887148    1.035176         0.018621\n14          BMI     0.125294    -0.050466    1.170460    0.922472         0.014760","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table bor